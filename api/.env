# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_local_dev_secret_32chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Host `db` is the Docker Compose MySQL service. From the host machine use 127.0.0.1:7001 instead.
DATABASE_URL="mysql://symfony:symfony@db:3306/symfony?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

PUBLIC_RECORDINGS_FOLDER="%kernel.project_dir%/public/recordings"
PUBLIC_FOLDER="%kernel.project_dir%/public"
PRIVATE_UNPROCESSED_RECORDINGS_FOLDER="%kernel.project_dir%/private/UnprocessedRecordings"

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

MAX_DISK_SIZE_USAGE_GB=100

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test123
###< lexik/jwt-authentication-bundle ###

RASPBERRY_BASE_URL='http://host.docker.internal:8080'

###> motion-detection v2 (docs/v2/) ###
# Dev-only placeholder, same pattern as JWT_PASSPHRASE above. event-bridge sends this as
# X-Bridge-Secret; see InternalEventController and docs/v2/07-api-and-data-model.md#internal.
# Real value for the cluster: generate one (e.g. `openssl rand -hex 32`) and put it in
# SOPS, not here -- see docs/v2/HANDOFF.md.
BRIDGE_SECRET=dev-bridge-secret-change-me

# Signs the short-lived media URLs (clips, snapshots, notification thumbnails) -- see
# MediaTokenService and docs/v2/07-api-and-data-model.md#media-tokens. Same rule: real
# value goes in SOPS for the cluster, not here.
MEDIA_SIGNING_KEY=dev-media-signing-key-change-me
###< motion-detection v2 (docs/v2/) ###

###> motion v2 ###
# Frigate, in-cluster. Never public: every byte the app shows comes through motion-api.
FRIGATE_BASE_URL='http://frigate:5000'
# go2rtc on the LAN, for the WebRTC rung only. Empty disables that rung.
WEBRTC_LAN_URL='http://192.168.1.248:1984'
###< motion v2 ###
# Seconds of padding either side of an event clip. Must stay at or below Frigate's
# record.*.pre_capture / post_capture (both 5 today) -- see docs/v2/12-open-work.md.
MEDIA_CLIP_PRE_ROLL_S=5
MEDIA_CLIP_POST_ROLL_S=5
