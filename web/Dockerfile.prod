# motion-web production image: the built SPA on nginx. No node at runtime.
#
# Build from the REPOSITORY ROOT (the nginx config is shared with motion-api):
#     docker build -f web/Dockerfile.prod -t motion-web .

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
# `npm ci` and not `npm install`: the lockfile is the point of having one.
RUN npm ci --no-audit --no-fund
COPY web/ ./
# Same-origin. The SPA and the API share motion.edwintenbrinke.nl and are split by path in
# the HTTPRoute, so the app calls /api/... relative and never needs to know the hostname --
# which is also what keeps the JWT cookie first-party.
ENV VITE_API_MODE=bff VITE_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/prod/nginx-web.conf /etc/nginx/conf.d/motion-web.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
