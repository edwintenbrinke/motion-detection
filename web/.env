# Which world the app talks to. 'bff' = the Symfony API; 'mock' = the in-memory adapter in
# src/api/adapters/mock, which needs no backend at all (npm run dev:mock).
VITE_API_MODE=bff

VITE_API_BASE_URL=https://api.edwintenbrinke.nl

# Minutes in the background before the app re-locks and asks for the fingerprint again.
VITE_RELOCK_MINUTES=5
